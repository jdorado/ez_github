{
  "schemaVersion": 2,
  "services": {
    "plugin": {
      "buildTarget": "runtime",
      "volumes": {
        "profile": "/state",
        "repositories": "/repos"
      },
      "workspace": true,
      "healthcheck": [
        "node",
        "/app/bin/github.mjs",
        "--version"
      ],
      "memoryMiB": 256
    }
  },
  "commands": {
    "github": {
      "service": "plugin",
      "argv": [
        "node",
        "/app/bin/github.mjs"
      ]
    },
    "github-work": {
      "service": "plugin",
      "argv": [
        "node",
        "/app/bin/work-check.mjs"
      ]
    }
  }
}
