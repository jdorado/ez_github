{
  "name": "@jc_stack/ez-github",
  "version": "0.1.0-beta.5",
  "description": "Native Git and GitHub CLI with private per-agent profiles for Ez",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdorado/ez_github.git"
  },
  "homepage": "https://github.com/jdorado/ez_github#readme",
  "bugs": {
    "url": "https://github.com/jdorado/ez_github/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "ezRelease": {
    "protocol": 1,
    "kind": "plugin",
    "stateSchema": 1,
    "mainProtocol": 1
  },
  "files": [
    "bin",
    "skills",
    "test",
    "scripts/release-check.mjs",
    "Dockerfile",
    ".dockerignore",
    "ez-plugin.json",
    "ez-deployment.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "pnpm-workspace.yaml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "node --check bin/github.mjs && node --check bin/work-check.mjs && pnpm test",
    "release:check": "node scripts/release-check.mjs"
  }
}
